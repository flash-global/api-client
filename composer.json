{
  "name": "fei/api-client",
  "description": "Client side API helpers",
  "type": "library",
  "license": "GPL-3.0",
  "authors": [
    {
      "name": "Yoctu",
      "email": "contact@yoctu.com",
      "homepage": "http://yoctu.com/"
    }
  ],
  "config": {
    "platform": {
      "php": "8.5.0"
    },
    "allow-plugins": {
      "phpro/grumphp": true
    }
  },
  "require": {
    "php": "^8.5",
    "fei/entities": "^3.0",
    "guzzlehttp/guzzle": "^7.9",
    "pda/pheanstalk": "^3.2",
    "ext-json": "*"
  },
  "require-dev": {
    "codeception/codeception": "^5.1",
    "phpro/grumphp": "^2.0",
    "squizlabs/php_codesniffer": "^3.13",
    "codeception/module-asserts": "^3.0",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  },
  "autoload": {
    "psr-4": {
      "Fei\\ApiClient\\": "src/"
    }
  },
  "bin": [
    "scripts/api-client-worker.php"
  ]
}
